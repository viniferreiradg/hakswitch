# --- retroarch (fork em C) ---
retroarch/build/
retroarch/build_switch/
retroarch/dist/
retroarch/*.nro
retroarch/*.nacp
retroarch/*.elf
retroarch/*.pfs0
# pasta de teste local (PC) - roms/capas/musica reais, mesmo motivo do
# template/local-data/: nunca versionar. hakswitch_init_paths() em
# menu_displaylist.c usa essa pasta como base quando roda no PC (fora do
# Switch).
retroarch/hakswitch/
retroarch/hakswitch_test_images/

# --- studio (Electron/TS) ---
studio/node_modules/
studio/out/
studio/dist/
studio/.vite/
studio/*.tsbuildinfo
studio/cores/

# --- template: conteudo local do pacote entregavel, nunca versionado
# (ROMs, capas, screenshots, cores .nro compilados, musica/sfx de terceiros,
# o .nro final) - fica so no disco, documentado em template/README.md ---
template/local-data/

# --- segredos: nunca devem chegar nem perto do git ---
prod.keys
*.keys
*.nsp

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
*.log
.claude/
retroarch/build_libnx_output*.txt
retroarch/build_libnx_verify.log
retroarch/build_*.txt
retroarch/configure_pc.txt

# mupen64plus_next é 155MB - acima do limite de 100MB do GitHub pra arquivo
# comum (precisaria de Git LFS). Fica só em disco, não versionado - se
# precisar recriar, o fix necessário (switch/mman.h, virtmemReserve ->
# virtmemFindAslr) está documentado na memória do projeto.
core-libs-backup/mupen64plus_next_libretro_libnx.a

# --- clones de trabalho dos repos upstream de cada core (libretro-*) -
# usados so pra extrair o .a estatico via Makefile.libretro platform=libnx;
# tem git proprio (repo aninhado) e são reclonaveis do GitHub publico a
# qualquer momento. O artefato que importa (o .a compilado) fica versionado
# em core-libs-backup/, não aqui. ---
core-src-*/
